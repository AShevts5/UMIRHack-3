# Образец настроек. Скопируйте в .env и раскомментируйте то, что нужно.
# .env в git не попадает (см. .gitignore), секреты держим только там.

# Порт на этой машине (внутри контейнера всегда 8000)
# PORT=8000

# Потолок памяти для контейнера (с мини-LLM нужно не меньше 3g)
# MEMORY=3g

# Мини-LLM помощника: 0 — выключить (и не качать модель), сколько секунд ждать ответ, сколько ядер дать
# UMIR_LLM=0
# UMIR_LLM_TIMEOUT=25
# UMIR_LLM_THREADS=4

# Кнопка «Войти в демо-аккаунт для жюри» на экране входа (1 или свой логин)
# UMIR_DEMO_ACCOUNT=1

# Вход через Яндекс ID: ключи приложения с oauth.yandex.ru и публичный адрес сайта,
# на который Яндекс вернёт пользователя (Redirect URI: <адрес>/api/auth/yandex/callback)
# UMIR_YANDEX_CLIENT_ID=
# UMIR_YANDEX_CLIENT_SECRET=
# UMIR_PUBLIC_URL=https://dekanatonline.ru

# Секрет подписи токенов. Если не задан, сервис сам создаёт его один раз и хранит в томе с данными
# UMIR_JWT_SECRET=

# Название команды в подвале (иначе берётся из backend/app/configs/app.yaml)
# UMIR_TEAM_NAME=

# Telegram-бот запускается отдельно: python -m backend.scripts.tasks bot
# UMIR_TELEGRAM_TOKEN=
