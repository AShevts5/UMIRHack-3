# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_tmp/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Frontend ---
node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo

# --- Артефакты прогонов ---
# results.json — это то, что сдаём, его коммитим специально, не игнорить.
reports/*.local.json
scratch/
*.log

# Сгенерированные наборы для замеров: их собирают командами
# tasks degraded / tasks ocr-quality, в репе они не нужны (это мегабайты
# картинок, которые и так получаются из открытого набора одной командой).
reports/degraded/
reports/synthetic/
reports/stress/

# --- Локальные данные ---
# Настоящие персональные данные в репозиторий не кладём: только синтетические
# документы от организаторов или те, что нагенерили тесты.
data/private/
# веса OCR, которые скачивает backend/scripts/download_models.py
/models/
# пользователи, история обращений и секрет JWT (UMIR_DATA_DIR) — сюда точно не коммитим
var/
*.env
.env.local

# --- ОС/редакторы ---
.DS_Store
Thumbs.db
.idea/
.vscode/
