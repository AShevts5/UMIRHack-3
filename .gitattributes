# Правила переводов строк.
#
# Зачем: на Windows git по умолчанию переводит файлы в CRLF, а bash-скрипты и
# Markdown с CRLF ломаются (bash: «\r: command not found», разбор пунктов
# Положения ловит лишний \r). Поэтому для них жёстко фиксируем LF.

* text=auto eol=lf

*.sh            text eol=lf
*.md            text eol=lf
*.py            text eol=lf
*.json          text eol=lf
*.yaml          text eol=lf
*.yml           text eol=lf
*.toml          text eol=lf
*.ts            text eol=lf
*.tsx           text eol=lf
*.css           text eol=lf

# Windows-специфичные файлы оставляем с CRLF
*.ps1           text eol=crlf
*.bat           text eol=crlf
*.cmd           text eol=crlf

# Бинарные файлы не трогаем
*.png           binary
*.jpg           binary
*.jpeg          binary
*.pdf           binary
*.ipynb         text eol=lf
pnpm-lock.yaml  text eol=lf
